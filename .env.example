# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Every value here has a working default in tests/config/settings.py, so a fresh
# clone runs against a local application with no .env at all — except for
# TEST_API_KEY, which has no safe default and must be set.
#
# Environment variables win over this file, which is how CI points the same
# suite at a service container or at the deployed demo.

# --- what to test ---------------------------------------------------------

# The application under test. Defaults to a local server; set it to the Render
# URL to run against the deployed demo (and see RESET_DATABASE below first).
API_BASE_URL=http://127.0.0.1:8000

# The frontend, for the browser suite from Phase 4 onwards. Vite binds to ::1,
# so use localhost rather than 127.0.0.1 — the numeric form will not answer.
WEB_BASE_URL=http://localhost:5173

# --- credentials ----------------------------------------------------------

# Guards POST /api/test/reset, which puts the database into its seeded state.
# This must be the same value the application was started with — it lives in the
# engage-app repository's own .env and in the Render dashboard. A mismatch shows
# up as "401 Missing or invalid X-Test-Key", which reads like a broken test
# rather than a stale secret, so check it here first.
TEST_API_KEY=change-me

# Guards POST /api/webhooks/delivery. Only needed from Phase 2, when the
# delivery and idempotency tests start posting receipts.
WEBHOOK_SECRET=change-me

# --- behaviour ------------------------------------------------------------

# The suite resets the database once per session so tests start from known
# state. Set this to false for any environment that must not be wiped — the
# deployed demo, or a database someone else is using. The deployed-smoke CI job
# sets it to false for exactly this reason.
RESET_DATABASE=true

# Left at their defaults unless you have a reason: SEED_PASSWORD (the shared
# password for every seeded user), REQUEST_TIMEOUT, POLL_TIMEOUT, POLL_INTERVAL.
